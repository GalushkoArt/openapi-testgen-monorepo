{
  "name": "@openapi-testgen/cli",
  "version": "0.0.0",
  "description": "Generate test cases from OpenAPI specifications",
  "keywords": [
    "openapi",
    "swagger",
    "testing",
    "api",
    "test-generation",
    "rest-api",
    "api-testing",
    "contract-testing"
  ],
  "homepage": "https://docs.galushko.art/openapi-test-generator/",
  "bugs": {
    "url": "https://github.com/GalushkoArt/openapi-testgen-monorepo/issues"
  },
  "license": "MIT",
  "author": "Artem Galushko",
  "bin": {
    "openapi-testgen": "./bin/openapi-testgen"
  },
  "files": [
