<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for standard output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger level (INFO for production, change to DEBUG for troubleshooting) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Set specific package log levels -->
    <logger name="art.galushko.openapi.testgen" level="INFO" />

    <!-- Reduce verbosity of third-party libraries -->
    <logger name="io.swagger.parser" level="WARN" />
    <logger name="com.fasterxml.jackson" level="WARN" />
</configuration>
